# Required on Vercel / Netlify (free database: https://console.upstash.com -> Redis -> REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
JWT_SECRET=            # long random string; if empty one is generated and stored in the database
ADMIN_PASSWORD=        # pre-sets the admin password on an empty database (otherwise you choose it on first visit)
